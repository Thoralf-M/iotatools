{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 4,
  "trailingComma": "all",
  "useTabs": false,
  "importOrder": [
    "<BUILT_IN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/(.*)$",
    "^~/(.*)$",
    "",
    "^[.]"
  ],
  "sortPackageJson": false,
  "ignorePatterns": [
    ".github/",
    "docs/",
    "*.json"
  ]
}
