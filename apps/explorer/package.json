{
  "name": "iota-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Developer-grade IOTA blockchain explorer built on the @iota/sdk-wasm bindings of iota-rust-sdk",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:integrated": "tsc -b && VITE_HASH_ROUTER=1 vite build --base=./"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@iota/sdk-wasm": "link:../../../iota-rust-sdk/bindings/wasm",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
