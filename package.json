        "@types/codemirror": "^5.60.15",
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte": "^5.19.9",
        "svelte-check": "^4.1.4",
        "typescript": "^5.6.3",
        "vite": "^6.1.0"
    },
    "dependencies": {
