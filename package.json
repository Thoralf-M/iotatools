{
    "name": "iota-tools",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "format:fix": "oxfmt src/ scripts/ && prettier -w \"**/*.svelte\"",
        "format:check": "oxfmt --check src/ scripts/ && prettier --check \"**/*.svelte\"",
        "lint": "oxlint src/",
        "prettier:fix": "pnpm run format:fix",
        "build": "vite build && node scripts/postbuild.js",
        "preview": "vite preview",
        "production": "node scripts/server.js",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
        "test": "vitest --run",
        "test:ui": "vitest --ui"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@tsconfig/svelte": "^5.0.8",
        "@types/codemirror": "^5.60.17",
        "@types/node": "^25.3.0",
        "@vitest/ui": "^4.1.4",
        "jsdom": "^29.0.2",
        "oxfmt": "^0.35.0",
        "oxlint": "^1.50.0",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.0",
        "svelte": "^5.53.5",
        "svelte-check": "^4.4.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.2",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "@babel/runtime": "^7.28.6",
        "@codemirror/lang-javascript": "^6.2.4",
        "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
        "@gandlaf21/bc-ur": "^1.1.12",
        "@iota/bcs": "^1.4.0",
        "@iota/graphql-transport": "^0.13.1",
        "@iota/iota-sdk": "^1.12.0",
        "@iota/ledgerjs-hw-app-iota": "^0.6.0",
        "@iota/wallet-standard": "^0.3.2",
        "@ledgerhq/hw-transport-webhid": "^6.31.0",
        "@lezer/highlight": "^1.2.3",
        "@noble/hashes": "^1.8.0",
        "@rollup/plugin-inject": "^5.0.5",
        "@scure/base": "^2.0.0",
        "@scure/bip39": "^1.6.0",
        "@sveltejs/svelte-json-tree": "^2.2.1",
        "@uiw/codemirror-theme-github": "^4.25.5",
        "bs58check": "^4.0.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "chartjs-plugin-zoom": "^2.2.0",
        "codemirror": "^6.0.2",
        "cytoscape": "^3.33.1",
        "cytoscape-dagre": "^2.5.0",
        "date-fns": "^4.1.0",
        "express": "^5.2.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.7",
        "process": "^0.11.10",
        "qr-scanner": "^1.4.2",
        "qrcode-generator": "^2.0.4",
        "svelte-dnd-action": "^0.9.69",
        "svelte-spa-router": "^4.0.1",
        "svelte-virtual": "1.0.0-next.22",
        "uuid": "^13.0.0"
    },
    "pnpm": {
        "overrides": {
            "lodash": "^4.18.1"
        }
    }
}
