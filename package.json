{
    "name": "iota-tools",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "format:fix": "oxfmt src/ scripts/ && prettier -w \"**/*.svelte\"",
        "format:check": "oxfmt --check src/ scripts/ && prettier --check \"**/*.svelte\"",
        "lint": "oxlint src/",
        "fix": "pnpm format:fix && pnpm lint",
        "prettier:fix": "pnpm run format:fix",
        "build": "pnpm run build:explorer && vite build && node scripts/postbuild.js",
        "preview": "vite preview",
        "production": "node scripts/server.js",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
        "test": "vitest --run",
        "test:ui": "vitest --ui",
        "dev:explorer": "pnpm --filter iota-explorer run dev",
        "build:explorer": "node scripts/build-explorer.js"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.1",
        "@tsconfig/svelte": "^5.0.8",
        "@types/codemirror": "^5.60.17",
        "@types/node": "^26.1.1",
        "@vitest/ui": "^4.1.10",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "prettier": "^3.9.5",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.6",
        "svelte-check": "^4.7.3",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@babel/runtime": "^8.0.0",
        "@codemirror/lang-javascript": "^6.2.5",
        "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
        "@gandlaf21/bc-ur": "^1.1.12",
        "@iota/bcs": "^1.6.0",
        "@iota/graphql-transport": "^0.18.0",
        "@iota/iota-sdk": "^1.15.0",
        "@iota/ledgerjs-hw-app-iota": "^0.6.2",
        "@iota/wallet-standard": "^0.4.4",
        "@ledgerhq/hw-transport-webhid": "^6.36.0",
        "@lezer/highlight": "^1.2.3",
        "@noble/hashes": "^2.2.0",
        "@rollup/plugin-inject": "^5.0.5",
        "@scure/base": "^2.2.0",
        "@scure/bip39": "^2.2.0",
        "@sveltejs/svelte-json-tree": "^2.2.1",
        "@uiw/codemirror-theme-github": "^4.25.11",
        "bs58check": "^4.0.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "chartjs-plugin-zoom": "^2.2.0",
        "codemirror": "^6.0.2",
        "cytoscape": "^3.34.0",
        "cytoscape-dagre": "^4.0.0",
        "date-fns": "^4.4.0",
        "express": "^5.2.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "process": "^0.11.10",
        "qr-scanner": "^1.4.2",
        "qrcode-generator": "^2.0.4",
        "svelte-dnd-action": "^0.9.74",
        "svelte-spa-router": "^5.1.1",
        "svelte-virtual": "1.0.0-next.22",
        "uuid": "^14.0.1"
    }
}
